<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PhoneTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#74AE9A</item>
        <item name="android:navigationBarColor">#F6F8F7</item>
        <item name="android:statusBarColor">#F6F8F7</item>
        <item name="android:windowBackground">#F6F8F7</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/PhoneDialogTheme</item>
    </style>

    <style name="PhoneDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#6F9D8D</item>
        <item name="android:textColorPrimary">#172A23</item>
        <item name="android:textColorSecondary">#687870</item>
        <item name="android:windowBackground">@drawable/phone_dialog_background</item>
        <item name="android:buttonBarButtonStyle">@style/PhoneDialogButton</item>
    </style>

    <style name="PhoneDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#527C6D</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-medium</item>
    </style>
</resources>
