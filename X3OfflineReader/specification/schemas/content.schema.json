{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opbook:schema:v1:content",
  "title": "OPBook v1 chapter content",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "chapterId", "blocks"],
  "properties": {
    "formatVersion": { "const": "1.0" },
    "chapterId": { "$ref": "#/$defs/id" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockId", "order", "type", "text"],
        "properties": {
          "blockId": { "$ref": "#/$defs/id" },
          "order": { "type": "integer", "minimum": 0 },
          "type": { "enum": ["heading", "paragraph", "quote", "separator"] },
          "text": { "type": "string", "maxLength": 1000000 },
          "sourceRef": { "$ref": "#/$defs/sourceRef" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "locator": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    }
  }
}

