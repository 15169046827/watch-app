{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opbook:schema:v1:timeline",
  "title": "OPBook v1 track timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "trackId", "chapterId", "durationMs", "segments"],
  "properties": {
    "formatVersion": { "const": "1.0" },
    "trackId": { "$ref": "#/$defs/id" },
    "chapterId": { "$ref": "#/$defs/id" },
    "durationMs": { "type": "integer", "minimum": 1 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segmentId", "startMs", "endMs", "text", "blockId", "startChar", "endChar"],
        "properties": {
          "segmentId": { "$ref": "#/$defs/id" },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1, "maxLength": 100000 },
          "blockId": { "$ref": "#/$defs/id" },
          "startChar": { "type": "integer", "minimum": 0 },
          "endChar": { "type": "integer", "minimum": 1 },
          "sourceRef": { "$ref": "#/$defs/sourceRef" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "locator": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    }
  }
}

