{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opbook:schema:v1:manifest",
  "title": "OPBook v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "book", "volumes", "checksumsPath", "createdWith"],
  "properties": {
    "format": { "const": "opbook" },
    "formatVersion": { "const": "1.0" },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bookId", "title", "authors", "language"],
      "properties": {
        "bookId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "authors": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "minItems": 1 },
        "language": { "type": "string", "minLength": 2, "maxLength": 35 },
        "coverPath": { "const": "cover.webp" }
      }
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["volumeId", "title", "order", "chapters"],
        "properties": {
          "volumeId": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1, "maxLength": 512 },
          "order": { "type": "integer", "minimum": 0 },
          "chapters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["chapterId", "title", "order", "contentPath", "tracks"],
              "properties": {
                "chapterId": { "$ref": "#/$defs/id" },
                "title": { "type": "string", "minLength": 1, "maxLength": 512 },
                "order": { "type": "integer", "minimum": 0 },
                "contentPath": { "type": "string", "pattern": "^content/[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$" },
                "tracks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["trackId", "order", "audioPath", "timelinePath", "durationMs", "mimeType"],
                    "properties": {
                      "trackId": { "$ref": "#/$defs/id" },
                      "order": { "type": "integer", "minimum": 0 },
                      "audioPath": { "type": "string", "pattern": "^audio/[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.m4a$" },
                      "timelinePath": { "type": "string", "pattern": "^timeline/[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$" },
                      "durationMs": { "type": "integer", "minimum": 1 },
                      "mimeType": { "const": "audio/mp4" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "checksumsPath": { "const": "checksums.json" },
    "createdWith": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "version"],
      "properties": {
        "application": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "audioEncoder": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
  }
}

