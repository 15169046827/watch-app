<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.X3OfflineReader" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="CompactGridButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">8sp</item>
    </style>
    <style name="PlayerIconButton" parent="android:style/Widget.Material.ImageButton">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:tint">@color/player_icon_tint</item>
        <item name="android:alpha">1</item>
        <item name="android:scaleX">1</item>
        <item name="android:scaleY">1</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">12dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
    <style name="PlayerPrimaryButton" parent="PlayerIconButton">
        <item name="android:background">@drawable/player_primary_button_background</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:alpha">1</item>
        <item name="android:scaleX">1</item>
        <item name="android:scaleY">1</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="ReaderSeekButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/reader_seek_button_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
    <style name="Theme.X3OfflineReader.NoDisplay" parent="android:style/Theme.NoDisplay" />
</resources>
