<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="20dp" android:paddingEnd="24dp" android:paddingBottom="20dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="24dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/lyric" android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center" android:maxLines="2" android:textColor="@color/accent" android:textSize="15sp" />
    <TextView android:id="@+id/position" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="10sp" />
    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <Button android:id="@+id/previous_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="@string/previous" android:text="@string/previous_symbol" />
        <Button android:id="@+id/play_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/play" />
        <Button android:id="@+id/next_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="@string/next" android:text="@string/next_symbol" />
        <Button android:id="@+id/favorite_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/favorite" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="31dp" android:orientation="horizontal">
        <Button android:id="@+id/speed_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/speed_default" />
        <Button android:id="@+id/mode_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/mode_stop_after_track" />
        <Button android:id="@+id/volume_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/volume_title" />
        <Button android:id="@+id/output_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/output_title" />
    </LinearLayout>
</LinearLayout>
