<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="18dp" android:paddingEnd="24dp" android:paddingBottom="18dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="22dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
    <ScrollView android:id="@+id/reader_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fadeScrollbars="true"><TextView android:id="@+id/full_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="4dp" android:textColor="@color/text_secondary" android:textSize="14sp" /></ScrollView>
    <TextView android:id="@+id/position" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="10sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="31dp" android:orientation="horizontal">
        <Button android:id="@+id/previous_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="0.65" android:text="@string/previous_symbol" />
        <Button android:id="@+id/back_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/back_15" />
        <Button android:id="@+id/play_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/play" />
        <Button android:id="@+id/forward_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/forward_15" />
        <Button android:id="@+id/next_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="0.65" android:text="@string/next_symbol" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="31dp" android:orientation="horizontal">
        <Button android:id="@+id/speed_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/speed_default" />
        <Button android:id="@+id/favorite_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/favorite" />
        <Button android:id="@+id/volume_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/volume_title" />
        <Button android:id="@+id/output_button" style="@style/CompactGridButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/output_title" />
    </LinearLayout>
</LinearLayout>
