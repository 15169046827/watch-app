<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="24dp" android:paddingEnd="24dp" android:paddingBottom="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center" android:text="@string/app_name" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:text="@string/choose_mode" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="74dp" android:layout_marginTop="12dp" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/books_button" android:layout_width="0dp" android:layout_height="66dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/watch_novel_tile" android:drawableTop="@drawable/ic_player_directory" android:minWidth="0dp" android:paddingTop="10dp" android:paddingBottom="8dp" android:text="@string/novels" android:textColor="#C3FFF2" android:textSize="16sp" />
        <Button android:id="@+id/music_button" android:layout_width="0dp" android:layout_height="66dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/watch_music_tile" android:drawableTop="@drawable/ic_watch_music" android:minWidth="0dp" android:paddingTop="10dp" android:paddingBottom="8dp" android:text="@string/music" android:textColor="#F2C9FF" android:textSize="16sp" />
    </LinearLayout>
    <Button android:id="@+id/data_button" android:layout_width="116dp" android:layout_height="40dp" android:layout_marginTop="4dp" android:background="@drawable/watch_action_pill" android:minHeight="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:maxLines="1" android:text="@string/data_and_migration" android:textSize="13sp" />
</LinearLayout>
