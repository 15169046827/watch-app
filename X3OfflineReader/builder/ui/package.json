{
  "name": "tingdu-workshop-ui",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -b --noEmit",
    "build": "npm run lint && npm run typecheck && vite build --minify oxc",
    "tauri": "tauri",
    "desktop:build": "tauri build --no-bundle --features custom-protocol"
  },
  "dependencies": {
    "@primeuix/themes": "1.2.5",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.1.5"
  }
}
