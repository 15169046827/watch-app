{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "听读工坊",
  "version": "0.6.3",
  "identifier": "com.canace.x3offlinereader.builder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; media-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "听读工坊",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["../../assets/tingdu-workshop-icon.ico"]
  }
}
